{
  "name": "app-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:development": "ng build --configuration development",
    "build:production": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:backend": "cd .. && dotnet tool restore && dotnet csharpier format .",
    "format:backend:check": "cd .. && dotnet tool restore && dotnet csharpier check .",
    "prepare": "cd .. && npx --prefix ./Client husky && dotnet tool restore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "npm run lint:fix && npm run format"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@azure/msal-angular": "^6.2.0",
    "@azure/msal-browser": "^5.21.0",
    "@microsoft/signalr": "^10.0.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.0.8"
  }
}
