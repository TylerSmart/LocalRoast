<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <SpaDist>..\Client\dist\App.Client\browser\</SpaDist>
    <UserSecretsId>919916c8-48e7-4a03-8870-b676f64887dc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\App.Core.csproj" />
    <ProjectReference Include="..\Data\App.Data.csproj" />
    <ProjectReference Include="..\Infrastructure\App.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target
    Name="EnsureLocalInfrastructure"
    BeforeTargets="BeforeBuild"
    Condition="'$(BuildingInsideVisualStudio)' == 'true' AND '$(Configuration)' == 'Debug' AND '$(DesignTimeBuild)' != 'true'"
  >
    <PropertyGroup>
      <_EnsureLocalInfraScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\scripts\ensure-local-infra.ps1'))</_EnsureLocalInfraScript>
    </PropertyGroup>
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_EnsureLocalInfraScript)&quot;"
      WorkingDirectory="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))"
      IgnoreStandardErrorWarningFormat="true"
    />
  </Target>

  <Target Name="IncludeAngularInPublish" AfterTargets="ComputeFilesToPublish">
    <Error
      Text="Angular output was not found at $(SpaDist). Run npm run build:development (or build:production) in Client before publishing."
      Condition="'$(RequireSpaPublish)' == 'true' AND !Exists('$(SpaDist)index.html')"
    />
    <ItemGroup Condition="Exists('$(SpaDist)index.html')">
      <_SpaFiles Include="$(SpaDist)**\*" />
      <ResolvedFileToPublish Include="@(_SpaFiles)">
        <RelativePath>wwwroot\%(_SpaFiles.RecursiveDir)%(_SpaFiles.FileName)%(_SpaFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
