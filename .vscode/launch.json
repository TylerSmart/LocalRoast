{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (watch + attach)",
      "type": "coreclr",
      "request": "attach",
      "processName": "App.API",
      "preLaunchTask": "api: watch"
    },
    {
      "name": "Attach to API (.NET)",
      "type": "coreclr",
      "request": "attach",
      "processName": "App.API"
    },
    {
      "name": "Launch API (.NET Core)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/API/bin/Debug/net10.0/App.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Launch Client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/Client",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*",
        "/src/*": "${webRoot}/src/*",
        "src/*": "${webRoot}/src/*"
      },
      "preLaunchTask": "client: start"
    },
    {
      "name": "Launch Client (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/Client",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*",
        "/src/*": "${webRoot}/src/*",
        "src/*": "${webRoot}/src/*"
      },
      "preLaunchTask": "client: start"
    },
    {
      "name": "Launch Client (Chrome, dev server already running)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/Client",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*",
        "/src/*": "${webRoot}/src/*",
        "src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Attach to Client (Chrome)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/Client",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug E2E Tests (Headed Browser)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "e2e: build",
      "program": "${workspaceFolder}/Tests/Client.E2ETests/bin/Debug/net10.0/App.Client.E2ETests.dll",
      "args": [
        "--settings",
        "${workspaceFolder}/Tests/Client.E2ETests/playwright.headed.runsettings",
        "--filter",
        "FullyQualifiedName~${input:e2eTestFilter}"
      ],
      "cwd": "${workspaceFolder}/Tests/Client.E2ETests",
      "stopAtEntry": false,
      "env": {
        "HEADED": "1"
      }
    },
    {
      "name": "Debug E2E Tests (Playwright Inspector)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "e2e: build",
      "program": "${workspaceFolder}/Tests/Client.E2ETests/bin/Debug/net10.0/App.Client.E2ETests.dll",
      "args": ["--filter", "FullyQualifiedName~${input:e2eTestFilter}"],
      "cwd": "${workspaceFolder}/Tests/Client.E2ETests",
      "stopAtEntry": false,
      "env": {
        "HEADED": "1",
        "PWDEBUG": "1"
      }
    }
  ],
  "inputs": [
    {
      "id": "e2eTestFilter",
      "type": "promptString",
      "description": "Test class or method name filter (leave as 'E2ETests' to run all, or enter e.g. 'MealPlanE2ETests' or a test method name)",
      "default": "ClientSmokeTests"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (watch)",
      "configurations": ["API (watch + attach)", "Launch Client (Chrome)"]
    },
    {
      "name": "Full Stack (API + Client)",
      "configurations": ["Launch API (.NET Core)", "Launch Client (Chrome)"]
    }
  ]
}
