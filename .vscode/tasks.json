{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "infra: ensure",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/ensure-local-infra.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "client: start",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/Client"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": ["relative", "${workspaceFolder}/Client"],
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*(?:Building|Watch mode enabled|bundling dependencies).*$",
          "endsPattern": "^.*(?:Local:\\s+https?:\\/\\/localhost:[0-9]+\\/|Application bundle generation complete).*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "api: build",
      "command": "dotnet",
      "type": "process",
      "dependsOn": "infra: ensure",
      "args": [
        "build",
        "${workspaceFolder}/API/App.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: watch",
      "type": "process",
      "command": "dotnet",
      "isBackground": true,
      "dependsOn": "infra: ensure",
      "args": [
        "watch",
        "run",
        "--non-interactive",
        "--project",
        "${workspaceFolder}/API/App.API.csproj",
        "--launch-profile",
        "http"
      ],
      "options": {
        "cwd": "${workspaceFolder}/API",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
        }
      },
      "problemMatcher": {
        "owner": "dotnet-watch",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*dotnet watch.*$",
          "endsPattern": "^.*Now listening on:\\s+https?:\\/\\/\\S+.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "e2e: build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Tests/Client.E2ETests/App.Client.E2ETests.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "e2e: run headed (slow-mo)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "--project",
        "${workspaceFolder}/Tests/Client.E2ETests/App.Client.E2ETests.csproj",
        "--",
        "--settings",
        "${workspaceFolder}/Tests/Client.E2ETests/playwright.headed.runsettings"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
